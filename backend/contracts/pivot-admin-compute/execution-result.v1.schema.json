{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justgo.lol/schemas/pivot-admin-compute/execution-result.v1.json",
  "title": "Pivot admin compute execution result v1 (bounded proposals and artifact manifests)",
  "oneOf": [
    { "$ref": "#/$defs/discoveryResult" },
    { "$ref": "#/$defs/refreshResult" },
    { "$ref": "#/$defs/carouselResult" },
    { "$ref": "#/$defs/composeResult" }
  ],
  "$defs": {
    "resultEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "jobId",
        "scheduleOccurrenceId",
        "kind",
        "cityKey",
        "implementationRevision",
        "basedOnContextVersion",
        "completedAt",
        "outcome",
        "idempotencyKey",
        "proposals",
        "summary"
      ],
      "properties": {
        "contractVersion": { "const": "1" },
        "jobId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "scheduleOccurrenceId": {
          "oneOf": [
            { "type": "string", "pattern": "^sched:[a-z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.-]+Z$" },
            { "type": "null" }
          ]
        },
        "kind": { "enum": ["city-source-discovery", "city-curation-refresh"] },
        "cityKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "implementationRevision": { "type": "string", "pattern": "^[a-zA-Z0-9@._+-]+$", "maxLength": 128 },
        "basedOnContextVersion": { "type": "string", "pattern": "^ctx:[a-zA-Z0-9._-]+$" },
        "completedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["completed", "failed", "cancelled"] },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 64 },
            "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "indexUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "discoveredVia": { "type": "string", "maxLength": 500 }
      }
    },
    "sourceProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "host", "url", "provider", "status", "basedOnRecordVersion"],
      "properties": {
        "action": { "enum": ["create", "update"] },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "label": { "oneOf": [{ "type": "string", "maxLength": 300 }, { "type": "null" }] },
        "provider": { "enum": ["partiful", "luma", "generic-site"] },
        "status": { "enum": ["qualified", "rejected"] },
        "enabled": { "type": "boolean" },
        "seedTags": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "maxLength": 64 }
        },
        "rejectedReason": {
          "oneOf": [
            {
              "enum": [
                "no-events",
                "below-threshold",
                "scrape-failed",
                "no-index-page",
                "blocked-host"
              ]
            },
            { "type": "null" }
          ]
        },
        "basedOnRecordVersion": {
          "oneOf": [
            { "type": "string", "pattern": "^rv:[a-zA-Z0-9._-]+$" },
            { "type": "null" }
          ]
        },
        "evidence": { "$ref": "#/$defs/sourceEvidence" }
      }
    },
    "curationJobProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "label", "provider", "basedOnRecordVersion"],
      "properties": {
        "action": { "enum": ["create", "update"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 },
        "url": { "oneOf": [{ "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 }, { "type": "null" }] },
        "provider": { "enum": ["partiful", "luma", "generic-site"] },
        "enabled": { "type": "boolean" },
        "defaultTags": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "maxLength": 64 }
        },
        "basedOnRecordVersion": {
          "oneOf": [
            { "type": "string", "pattern": "^rv:[a-zA-Z0-9._-]+$" },
            { "type": "null" }
          ]
        },
        "linkedSourceHost": { "oneOf": [{ "type": "string", "maxLength": 253 }, { "type": "null" }] }
      }
    },
    "eventDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourceUrl", "start_time"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "oneOf": [{ "type": "string", "maxLength": 5000 }, { "type": "null" }] },
        "image": { "oneOf": [{ "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 }, { "type": "null" }] },
        "location": { "oneOf": [{ "type": "string", "maxLength": 500 }, { "type": "null" }] },
        "rawLocationText": { "oneOf": [{ "type": "string", "maxLength": 500 }, { "type": "null" }] },
        "start_time": { "type": "string", "format": "date-time" },
        "end_time": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "hostName": { "oneOf": [{ "type": "string", "maxLength": 300 }, { "type": "null" }] },
        "hostProfileUrl": { "oneOf": [{ "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 }, { "type": "null" }] },
        "scrapeEvidence": {
          "type": "object", "additionalProperties": false,
          "required": ["imageCandidates", "appliedRuleIds"],
          "properties": {
            "imageCandidates": { "type": "array", "maxItems": 6,
              "items": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 } },
            "appliedRuleIds": { "type": "array", "maxItems": 30,
              "items": { "type": "string", "maxLength": 200 } }
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "maxLength": 64 }
        }
      }
    },
    "eventProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "sourceUrl", "batchWeek", "draft", "basedOnEventVersion"],
      "properties": {
        "action": { "const": "upsert" },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "batchWeek": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
        "draft": { "$ref": "#/$defs/eventDraft" },
        "basedOnEventVersion": {
          "oneOf": [
            { "type": "string", "pattern": "^rv:[a-zA-Z0-9._-]+$" },
            { "type": "null" }
          ]
        },
        "linkedJobId": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{24}$" }, { "type": "null" }] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "discoveredFromHost": { "type": "string", "maxLength": 253 },
            "provider": { "enum": ["partiful", "luma", "generic-site"] }
          }
        }
      }
    },
    "discoveryProposals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "curationJobs", "events"],
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/sourceProposal" }
        },
        "curationJobs": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/curationJobProposal" }
        },
        "events": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/eventProposal" }
        }
      }
    },
    "discoverySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["searched", "qualified", "rejected", "eventsProposed"],
      "properties": {
        "searched": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "qualified": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "rejected": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "eventsProposed": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "jobRefreshOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "outcome", "basedOnRecordVersion"],
      "properties": {
        "jobId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "outcome": { "enum": ["completed", "failed", "skipped"] },
        "basedOnRecordVersion": { "type": "string", "pattern": "^rv:[a-zA-Z0-9._-]+$" },
        "hintCount": { "type": "integer", "minimum": 0, "maximum": 30 },
        "extractionRequests": { "type": "integer", "minimum": 0, "maximum": 10 },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "maxLength": 64 },
            "message": { "type": "string", "maxLength": 1000 }
          }
        }
      }
    },
    "refreshProposals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobOutcomes", "events"],
      "properties": {
        "jobOutcomes": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/jobRefreshOutcome" }
        },
        "events": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/eventProposal" }
        }
      }
    },
    "refreshSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobsRun", "jobsFailed", "eventsProposed", "eventsRefreshed"],
      "properties": {
        "jobsRun": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "jobsFailed": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "eventsProposed": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "eventsRefreshed": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "discoveryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "jobId",
        "scheduleOccurrenceId",
        "kind",
        "cityKey",
        "implementationRevision",
        "basedOnContextVersion",
        "completedAt",
        "outcome",
        "idempotencyKey",
        "proposals",
        "summary"
      ],
      "properties": {
        "contractVersion": { "const": "1" },
        "jobId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "scheduleOccurrenceId": {
          "oneOf": [
            { "type": "string", "pattern": "^sched:[a-z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.-]+Z$" },
            { "type": "null" }
          ]
        },
        "kind": { "const": "city-source-discovery" },
        "cityKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "implementationRevision": { "type": "string", "pattern": "^[a-zA-Z0-9@._+-]+$", "maxLength": 128 },
        "basedOnContextVersion": { "type": "string", "pattern": "^ctx:[a-zA-Z0-9._-]+$" },
        "completedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["completed", "failed", "cancelled"] },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "maxLength": 64 },
            "message": { "type": "string", "maxLength": 1000 }
          }
        },
        "proposals": { "$ref": "#/$defs/discoveryProposals" },
        "summary": { "$ref": "#/$defs/discoverySummary" }
      }
    },
    "refreshResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "jobId",
        "scheduleOccurrenceId",
        "kind",
        "cityKey",
        "implementationRevision",
        "basedOnContextVersion",
        "completedAt",
        "outcome",
        "idempotencyKey",
        "proposals",
        "summary"
      ],
      "properties": {
        "contractVersion": { "const": "1" },
        "jobId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "scheduleOccurrenceId": {
          "oneOf": [
            { "type": "string", "pattern": "^sched:[a-z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.-]+Z$" },
            { "type": "null" }
          ]
        },
        "kind": { "const": "city-curation-refresh" },
        "cityKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "implementationRevision": { "type": "string", "pattern": "^[a-zA-Z0-9@._+-]+$", "maxLength": 128 },
        "basedOnContextVersion": { "type": "string", "pattern": "^ctx:[a-zA-Z0-9._-]+$" },
        "completedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["completed", "failed", "cancelled"] },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "maxLength": 64 },
            "message": { "type": "string", "maxLength": 1000 }
          }
        },
        "proposals": { "$ref": "#/$defs/refreshProposals" },
        "summary": { "$ref": "#/$defs/refreshSummary" }
      }
    },
    "carouselArtifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["logicalName", "artifactId", "mimeType", "byteCount", "sha256", "slideNumber"],
          "properties": {
            "logicalName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9._-]+\\.png$" },
            "artifactId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
            "mimeType": { "const": "image/png" },
            "byteCount": { "type": "integer", "minimum": 1, "maximum": 67108864 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "slideNumber": { "type": "integer", "minimum": 1, "maximum": 20 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["logicalName", "artifactId", "mimeType", "byteCount", "sha256", "slideNumber"],
          "properties": {
            "logicalName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9._-]+\\.zip$" },
            "artifactId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
            "mimeType": { "const": "application/zip" },
            "byteCount": { "type": "integer", "minimum": 1, "maximum": 67108864 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "slideNumber": { "type": "null" }
          }
        }
      ]
    },
    "composeEventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTenantKey", "eventId", "basedOnRecordVersion"],
      "properties": {
        "sourceTenantKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "eventId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "basedOnRecordVersion": { "type": "string", "pattern": "^rv:[a-zA-Z0-9._-]+$" },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "maxLength": 256, "pattern": "^ev:[a-zA-Z0-9._:-]+$" }
        }
      }
    },
    "composeAssetChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "assetRef"],
      "properties": {
        "provider": { "enum": ["event-poster", "unsplash"] },
        "assetRef": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^(?:event-poster|unsplash):[A-Za-z0-9._:-]+$" },
        "credit": { "oneOf": [{ "type": "string", "maxLength": 300 }, { "type": "null" }] },
        "creditUrl": { "oneOf": [{ "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 }, { "type": "null" }] },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "focalX": { "type": "number" },
            "focalY": { "type": "number" },
            "zoom": { "type": "number" }
          }
        }
      }
    },
    "composeCover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "subtitle", "family", "variation", "asset"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "maxLength": 300 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 300 },
        "family": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "variation": { "type": "integer", "minimum": 1, "maximum": 12 },
        "asset": { "$ref": "#/$defs/composeAssetChoice" },
        "repeatReason": { "oneOf": [{ "type": "string", "maxLength": 500 }, { "type": "null" }] },
        "alternativeHeadlines": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["headline", "subtitle"],
            "properties": {
              "headline": { "type": "string", "minLength": 1, "maxLength": 300 },
              "subtitle": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        }
      }
    },
    "composeEventSlide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventRef", "blurb", "presetId", "asset"],
      "properties": {
        "eventRef": { "$ref": "#/$defs/composeEventRef" },
        "blurb": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "presetId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "asset": { "$ref": "#/$defs/composeAssetChoice" }
      }
    },
    "composeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "inspectedSlides", "factualFindings", "visualFindings"],
      "properties": {
        "disposition": { "enum": ["ready-for-review", "repair", "needs-editor"] },
        "inspectedSlides": { "type": "integer", "minimum": 0, "maximum": 20 },
        "repairPasses": { "type": "integer", "minimum": 0, "maximum": 5 },
        "contactSheetInspected": { "type": "boolean" },
        "factualFindings": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z0-9_-]+$" },
              "message": { "type": "string", "minLength": 1, "maxLength": 500 },
              "slideNumber": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 20 }, { "type": "null" }] }
            }
          }
        },
        "visualFindings": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z0-9_-]+$" },
              "message": { "type": "string", "minLength": 1, "maxLength": 500 },
              "slideNumber": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 20 }, { "type": "null" }] }
            }
          }
        }
      }
    },
    "composeProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalIdempotencyKey",
        "theme",
        "editorialAngle",
        "cover",
        "eventSlides",
        "socialCaption",
        "review"
      ],
      "properties": {
        "proposalIdempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "theme": { "type": "string", "minLength": 1, "maxLength": 300 },
        "editorialAngle": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "cover": { "$ref": "#/$defs/composeCover" },
        "eventSlides": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/composeEventSlide" }
        },
        "socialCaption": { "type": "string", "minLength": 1, "maxLength": 2200 },
        "closingSlide": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["presetId", "copy"],
              "properties": {
                "presetId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "copy": { "type": "string", "minLength": 1, "maxLength": 500 }
              }
            },
            { "type": "null" }
          ]
        },
        "review": { "$ref": "#/$defs/composeReview" }
      }
    },
    "composeDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "stageReached",
        "basedOnPolicyVersion",
        "basedOnFeedbackVersion",
        "briefReasons",
        "coverage"
      ],
      "properties": {
        "disposition": { "enum": ["ready-for-review", "wait", "needs-editor"] },
        "stageReached": { "enum": ["assessment", "composition", "review"] },
        "basedOnPolicyVersion": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^pol:[a-zA-Z0-9._-]+$" },
        "basedOnFeedbackVersion": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^fb:[a-zA-Z0-9._-]+$" },
        "proposedPublicationAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "reconsiderAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "reconsiderTrigger": { "oneOf": [{ "type": "string", "maxLength": 500 }, { "type": "null" }] },
        "briefReasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "alternatives": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["theme", "reason"],
            "properties": {
              "theme": { "type": "string", "minLength": 1, "maxLength": 300 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "eventRefs": {
                "type": "array",
                "maxItems": 8,
                "items": { "$ref": "#/$defs/composeEventRef" }
              }
            }
          }
        },
        "evidenceGaps": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "selectedEventRefs": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/composeEventRef" }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestedTenantKeys", "examinedTenantKeys", "pagesExamined", "candidatesConsidered", "truncated"],
          "properties": {
            "requestedTenantKeys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" }
            },
            "examinedTenantKeys": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" }
            },
            "pagesExamined": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "candidatesConsidered": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "truncated": { "type": "boolean" },
            "sourceFailures": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tenantKey", "code", "message"],
                "properties": {
                  "tenantKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
                  "code": { "type": "string", "maxLength": 64 },
                  "message": { "type": "string", "maxLength": 500 }
                }
              }
            }
          }
        }
      }
    },
    "composeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "jobId",
        "scheduleOccurrenceId",
        "kind",
        "cityKey",
        "tenantKey",
        "accountId",
        "attemptId",
        "implementationRevision",
        "basedOnContextVersion",
        "completedAt",
        "outcome",
        "idempotencyKey",
        "decision",
        "proposal"
      ],
      "properties": {
        "contractVersion": { "const": "1" },
        "jobId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "scheduleOccurrenceId": {
          "oneOf": [
            { "type": "string", "pattern": "^sched:[a-z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.-]+Z$" },
            { "type": "null" }
          ]
        },
        "kind": { "const": "carousel-compose" },
        "cityKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "tenantKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "accountId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "attemptId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "implementationRevision": { "type": "string", "pattern": "^[a-zA-Z0-9@._+-]+$", "maxLength": 128 },
        "basedOnContextVersion": { "type": "string", "pattern": "^ctx:[a-zA-Z0-9._-]+$" },
        "completedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["completed", "failed", "cancelled"] },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "decision": { "$ref": "#/$defs/composeDecision" },
        "proposal": {
          "oneOf": [
            { "$ref": "#/$defs/composeProposal" },
            { "type": "null" }
          ]
        },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "maxLength": 64 },
            "message": { "type": "string", "maxLength": 1000 }
          }
        }
      }
    },
    "carouselResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion", "jobId", "scheduleOccurrenceId", "kind", "tenantKey",
        "cityKey", "deckId", "attemptId", "implementationRevision",
        "basedOnContextVersion", "completedAt", "outcome", "idempotencyKey",
        "renderedDeckRevision", "slideCount", "renderDurationMs", "artifacts", "warnings"
      ],
      "properties": {
        "contractVersion": { "const": "1" },
        "jobId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "scheduleOccurrenceId": { "type": "null" },
        "kind": { "const": "carousel-export" },
        "tenantKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "cityKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "deckId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "attemptId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "implementationRevision": { "type": "string", "pattern": "^[a-zA-Z0-9@._+-]+$", "maxLength": 128 },
        "basedOnContextVersion": { "type": "string", "pattern": "^ctx:[a-zA-Z0-9._-]+$" },
        "completedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["completed", "failed", "cancelled"] },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "renderedDeckRevision": { "type": "string", "format": "date-time", "maxLength": 40 },
        "slideCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "renderDurationMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "artifacts": {
          "type": "array", "maxItems": 21,
          "items": { "$ref": "#/$defs/carouselArtifact" }
        },
        "warnings": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z0-9_-]+$" },
              "message": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        },
        "failure": {
          "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "maxLength": 64 },
            "message": { "type": "string", "maxLength": 1000 }
          }
        }
      }
    }
  }
}
