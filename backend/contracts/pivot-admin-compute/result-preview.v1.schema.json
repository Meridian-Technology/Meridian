{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justgo.lol/schemas/pivot-admin-compute/result-preview.v1.json",
  "title": "Pivot admin compute result application preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "jobId",
    "scheduleOccurrenceId",
    "kind",
    "cityKey",
    "implementationRevision",
    "contextVersion",
    "basedOnContextVersion",
    "previewedAt",
    "applyAllowed",
    "rows",
    "summary"
  ],
  "properties": {
    "contractVersion": { "const": "1" },
    "jobId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
    "scheduleOccurrenceId": {
      "oneOf": [
        { "type": "string", "pattern": "^sched:[a-z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.-]+Z$" },
        { "type": "null" }
      ]
    },
    "kind": { "enum": ["city-source-discovery", "city-curation-refresh"] },
    "cityKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "implementationRevision": { "type": "string", "pattern": "^[a-zA-Z0-9@._+-]+$", "maxLength": 128 },
    "contextVersion": { "type": "string", "pattern": "^ctx:[a-zA-Z0-9._-]+$" },
    "basedOnContextVersion": { "type": "string", "pattern": "^ctx:[a-zA-Z0-9._-]+$" },
    "previewedAt": { "type": "string", "format": "date-time" },
    "applyAllowed": { "type": "boolean" },
    "blockingReasons": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "maxLength": 64 },
          "message": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "applyWarnings": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "maxLength": 64 },
          "message": { "type": "string", "maxLength": 500 },
          "skippedCount": { "type": "integer", "minimum": 0, "maximum": 10000 }
        }
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityType", "action", "key"],
        "properties": {
          "entityType": { "enum": ["source", "curationJob", "event"] },
          "action": {
            "enum": ["create", "update", "unchanged", "conflict", "rejected", "stale"]
          },
          "key": { "type": "string", "minLength": 1, "maxLength": 512 },
          "basedOnRecordVersion": {
            "oneOf": [
              { "type": "string", "pattern": "^rv:[a-zA-Z0-9._-]+$" },
              { "type": "null" }
            ]
          },
          "currentRecordVersion": {
            "oneOf": [
              { "type": "string", "pattern": "^rv:[a-zA-Z0-9._-]+$" },
              { "type": "null" }
            ]
          },
          "message": { "oneOf": [{ "type": "string", "maxLength": 1000 }, { "type": "null" }] },
          "applyBlocked": { "type": "boolean" },
          "missingFields": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "maxLength": 64 }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
              "host": { "type": "string", "maxLength": 253 },
              "jobId": { "type": "string", "pattern": "^[0-9a-f]{24}$" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creates", "updates", "unchanged", "conflicts", "rejected", "stale"],
      "properties": {
        "creates": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "updates": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "unchanged": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "conflicts": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "rejected": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "stale": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "skipped": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    }
  }
}
