{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justgo.lol/schemas/pivot-admin-compute/diagnostic-export.v1.json",
  "title": "Pivot admin compute diagnostic export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "jobId",
    "scheduleOccurrenceId",
    "kind",
    "cityKey",
    "implementationRevision",
    "basedOnContextVersion",
    "exportedAt",
    "diagnostics"
  ],
  "properties": {
    "contractVersion": { "const": "1" },
    "jobId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
    "scheduleOccurrenceId": {
      "oneOf": [
        { "type": "string", "pattern": "^sched:[a-z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.-]+Z$" },
        { "type": "null" }
      ]
    },
    "kind": {
      "enum": [
        "city-source-discovery",
        "city-curation-refresh",
        "carousel-export",
        "carousel-compose",
        "discovery-rehearsal"
      ]
    },
    "cityKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "implementationRevision": { "type": "string", "pattern": "^[a-zA-Z0-9@._+-]+$", "maxLength": 128 },
    "basedOnContextVersion": { "type": "string", "pattern": "^ctx:[a-zA-Z0-9._-]+$" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["completed", "failed", "cancelled"] },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logs"],
      "properties": {
        "logs": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "maxLength": 2000 }
        },
        "steps": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "phase", "kind", "title"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "phase": { "type": "string", "maxLength": 64 },
              "kind": { "type": "string", "maxLength": 64 },
              "title": { "type": "string", "maxLength": 500 },
              "detail": { "oneOf": [{ "type": "string", "maxLength": 2000 }, { "type": "null" }] },
              "host": { "oneOf": [{ "type": "string", "maxLength": 253 }, { "type": "null" }] },
              "code": { "oneOf": [{ "type": "string", "maxLength": 64 }, { "type": "null" }] }
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startedFreeBytes": { "type": "integer", "minimum": 0 },
            "finishedFreeBytes": { "type": "integer", "minimum": 0 },
            "totalBytes": { "type": "integer", "minimum": 0 }
          }
        },
        "providerCalls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "searches": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "maps": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "scrapes": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "nativeCrawls": { "type": "integer", "minimum": 0, "maximum": 10000 }
          }
        },
        "internalRunId": { "type": "string", "maxLength": 128 },
        "workerAttemptId": { "type": "string", "maxLength": 128 },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 }
      }
    }
  }
}
