{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justgo.lol/schemas/pivot-admin-compute/job-request.v1.json",
  "title": "Pivot admin compute job request v1",
  "oneOf": [
    { "$ref": "#/$defs/discoveryRequest" },
    { "$ref": "#/$defs/refreshRequest" },
    { "$ref": "#/$defs/carouselRequest" }
  ],
  "$defs": {
    "tagList": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "discoveryOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": { "$ref": "#/$defs/tagList" },
        "maxQueries": { "type": "integer", "minimum": 1, "maximum": 50 },
        "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 50 },
        "minEvents": { "type": "integer", "minimum": 1, "maximum": 50 },
        "createJobs": { "type": "boolean" },
        "recheckRejected": { "type": "boolean" },
        "flow": {
          "type": "string",
          "enum": ["native-then-firecrawl", "native-only", "firecrawl-only"]
        },
        "lumaSlug": { "type": "string", "minLength": 1, "maxLength": 128 },
        "partifulSlug": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "refreshOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batchWeek": {
          "type": "string",
          "pattern": "^[0-9]{4}-W[0-9]{2}$"
        },
        "forceBatchWeek": { "type": "boolean" },
        "jobIds": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "pattern": "^[0-9a-f]{24}$" }
        }
      }
    },
    "carouselOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deckId", "deckRevision"],
      "properties": {
        "deckId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "deckRevision": { "type": "string", "format": "date-time", "maxLength": 40 },
        "slideNumbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      }
    },
    "discoveryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "jobId",
        "scheduleOccurrenceId",
        "kind",
        "cityKey",
        "implementationRevision",
        "contextVersion",
        "requestedAt",
        "options"
      ],
      "properties": {
        "contractVersion": { "const": "1" },
        "jobId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9:_-]+$"
        },
        "scheduleOccurrenceId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 8,
              "maxLength": 160,
              "pattern": "^sched:[a-z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.-]+Z$"
            },
            { "type": "null" }
          ]
        },
        "kind": { "const": "city-source-discovery" },
        "cityKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "implementationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9@._+-]+$"
        },
        "contextVersion": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^ctx:[a-zA-Z0-9._-]+$"
        },
        "requestedAt": { "type": "string", "format": "date-time" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9:_-]+$"
        },
        "options": { "$ref": "#/$defs/discoveryOptions" }
      }
    },
    "refreshRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "jobId",
        "scheduleOccurrenceId",
        "kind",
        "cityKey",
        "implementationRevision",
        "contextVersion",
        "requestedAt",
        "options"
      ],
      "properties": {
        "contractVersion": { "const": "1" },
        "jobId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9:_-]+$"
        },
        "scheduleOccurrenceId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 8,
              "maxLength": 160,
              "pattern": "^sched:[a-z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.-]+Z$"
            },
            { "type": "null" }
          ]
        },
        "kind": { "const": "city-curation-refresh" },
        "cityKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "implementationRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9@._+-]+$"
        },
        "contextVersion": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^ctx:[a-zA-Z0-9._-]+$"
        },
        "requestedAt": { "type": "string", "format": "date-time" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9:_-]+$"
        },
        "options": { "$ref": "#/$defs/refreshOptions" }
      }
    },
    "carouselRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "jobId",
        "scheduleOccurrenceId",
        "kind",
        "cityKey",
        "implementationRevision",
        "contextVersion",
        "requestedAt",
        "idempotencyKey",
        "options"
      ],
      "properties": {
        "contractVersion": { "const": "1" },
        "jobId": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "scheduleOccurrenceId": { "type": "null" },
        "kind": { "const": "carousel-export" },
        "cityKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "implementationRevision": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9@._+-]+$" },
        "contextVersion": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^ctx:[a-zA-Z0-9._-]+$" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9:_-]+$" },
        "options": { "$ref": "#/$defs/carouselOptions" }
      }
    }
  }
}
